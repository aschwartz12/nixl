+namespace {
+std::atomic<int> g_hsdiag_bt_done{0};
+void hsdiagThreadBt(int) {
+    void *frames[64];
+    const int n = backtrace(frames, 64);
+    char comm[32] = {0};
+    char path[64];
+    const long tid = syscall(SYS_gettid);
+    snprintf(path, sizeof(path), "/proc/self/task/%ld/comm", tid);
+    int fd = open(path, O_RDONLY);
+    if (fd >= 0) {
+        ssize_t r = read(fd, comm, sizeof(comm) - 1);
+        if (r > 0 && comm[r - 1] == '\n') comm[r - 1] = 0;
+        close(fd);
+    }
+    char hdr[160];
+    const int len = snprintf(hdr, sizeof(hdr), "HSDIAG-BT begin pid=%d tid=%ld comm=%s frames=%d\n",
+                             getpid(), tid, comm, n);
+    ssize_t w = write(2, hdr, len);
+    backtrace_symbols_fd(frames, n, 2);
+    const int len2 = snprintf(hdr, sizeof(hdr), "HSDIAG-BT end pid=%d tid=%ld\n", getpid(), tid);
+    w = write(2, hdr, len2);
+    (void)w;
+    g_hsdiag_bt_done.store(1);
+}
+void hsdiagDumpAll(int) {
+    const long self = syscall(SYS_gettid);
+    DIR *d = opendir("/proc/self/task");
+    if (d == nullptr) return;
+    while (dirent *e = readdir(d)) {
+        if (e->d_name[0] == '.') continue;
+        const long tid = atol(e->d_name);
+        if (tid == self) { hsdiagThreadBt(0); continue; }
+        g_hsdiag_bt_done.store(0);
+        if (syscall(SYS_tgkill, getpid(), tid, SIGRTMIN + 11) != 0) continue;
+        for (int i = 0; i < 2000 && g_hsdiag_bt_done.load() == 0; ++i) {
+            struct timespec ts = {0, 100000};
+            nanosleep(&ts, nullptr);
+        }
+    }
+    closedir(d);
+}
+void hsdiagInstall() {
+    static std::atomic<bool> done{false};
+    if (done.exchange(true)) return;
+    void *f[2];
+    backtrace(f, 2); // load the unwinder outside a signal handler
+    struct sigaction sa = {};
+    sa.sa_handler = hsdiagDumpAll;
+    sa.sa_flags = SA_RESTART;
+    sigaction(SIGRTMIN + 10, &sa, nullptr);
+    sa.sa_handler = hsdiagThreadBt;
+    sigaction(SIGRTMIN + 11, &sa, nullptr);
+    NIXL_WARN << "HSDIAG backtrace dump on signal " << (SIGRTMIN + 10) << " pid " << getpid();
+}
